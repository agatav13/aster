# Copy to `.env` and fill in real values for local development.
# Never commit secrets — `.env` is gitignored.

DJANGO_SECRET_KEY=dev-secret-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
DJANGO_ADMIN_URL=admin/

APP_BASE_URL=http://127.0.0.1:8000

# TMDB API
TMDB_API_KEY=your-tmdb-v3-key
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_LANGUAGE=pl-PL
TMDB_REQUEST_TIMEOUT=3
TMDB_RESPONSE_CACHE_TTL=900

# Email — either Brevo (preferred for prod) or plain SMTP.
BREVO_API_KEY=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@aster.example

# GitHub Issues (bug report bridge)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Optional Redis cache
REDIS_URL=

APP_LOG_LEVEL=INFO
